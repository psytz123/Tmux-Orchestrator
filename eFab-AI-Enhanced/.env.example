# Application Settings
APP_NAME=eFab-AI-Enhanced
APP_VERSION=2.0.0
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:8501","http://localhost:3000"]

# UI Configuration
UI_HOST=0.0.0.0
UI_PORT=8501

# Database Configuration
DATABASE_URL=postgresql://efab_user:efab_password@localhost:5432/efab_db
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ERP Integration
BEVERLY_KNITS_API_URL=
BEVERLY_KNITS_API_KEY=
SAP_ENDPOINT=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=

# ML Configuration
ML_MODEL_PATH=./models
ML_CONFIDENCE_THRESHOLD=0.8
ML_ENSEMBLE_WEIGHTS={"prophet": 0.3, "xgboost": 0.3, "lightgbm": 0.2, "lstm": 0.2}

# Planning Engine
PLANNING_HORIZON_DAYS=30
OPTIMIZATION_ALGORITHM=mixed_integer
OBJECTIVE_FUNCTION=minimize_cost
MAX_ITERATIONS=1000
CONVERGENCE_TOLERANCE=0.001

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=false
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# Feature Flags
ENABLE_ML_FORECASTING=true
ENABLE_MULTI_AGENT=true
ENABLE_REAL_TIME_UPDATES=true
ENABLE_ADVANCED_ANALYTICS=true